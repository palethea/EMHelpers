  "authors": ["Palethea"],
  "contact": {
    "homepage": "https://github.com/Palethea/EMHelpers",
    "sources": "https://github.com/Palethea/EMHelpers"
  },
  "license": "Apache-2.0",
  "icon": "assets/emhelpers/icon.png",
